require "json"

module Commandant::Bench
  # Which component a miss on a row implicates: the rule under review, or the
  # engine that parses and resolves commands before any rule sees them.
  enum Subject
    Rule
    Engine
  end

  # A mechanical rewrite of an example command that should not change whether
  # the rule fires (or, for wrappers, should not lower the verdict's severity).
  enum VariantKind
    Reorder
    Split
    Combine
    Alias
    Long
    Abbrev
    Quote
    EnvPrefix
    AbsPath
    ExeSuffix
    CmdExe
    Compound
    Sudo
    ShellWrap

    def subject : Subject
      case self
      when Reorder, Split, Combine, Alias, Long, Abbrev then Subject::Rule
      else                                                   Subject::Engine
      end
    end

    # True for wrappers, where another ruleset takes over and only the verdict's
    # severity can be checked.
    def at_least? : Bool
      compound? || sudo? || shell_wrap?
    end

    # True for kinds that need a ruleset's flag declaration (aliases and long
    # forms) and cannot be generated from an example alone.
    def needs_flag_declaration? : Bool
      alias? || long? || abbrev?
    end

    def name : String
      to_s.underscore.tr("_", "-")
    end

    def to_json(json : JSON::Builder) : Nil
      json.string(name)
    end
  end

  # One generated variant. A nil *command* means the variant could not be
  # generated, and *reason* says why.
  record Variant, kind : VariantKind, command : String?, platform : TargetPlatform, reason : String? = nil

  # Generates variants of an example command.
  #
  # ```
  # Variants.generate("rm -rf build/", tool: "rm", folder: "posix", known_flags: Set{"-r", "-f"})
  # ```
  #
  # Variants that need a flag declaration are not produced here; see
  # `VariantKind#needs_flag_declaration?`.
  module Variants
    SHELL_OPERATORS = /[|;&<>`]|\$\(/

    POSIX_ONLY = {VariantKind::EnvPrefix, VariantKind::AbsPath, VariantKind::Sudo, VariantKind::ShellWrap}

    # Returns one `Variant` per generable kind, in `VariantKind` order.
    # *known_flags* are the flags the ruleset mentions anywhere; they decide
    # whether a token such as `-rf` may be split into single-letter flags.
    def self.generate(example : String, tool : String, folder : String, known_flags : Set(String)) : Array(Variant)
      platform = TargetPlatform.for_folder(folder)
      tokens = Process.parse_arguments_posix(example)
      operators = example.matches?(SHELL_OPERATORS)
      starts_with_tool = tokens.first? == tool

      VariantKind.values.reject(&.needs_flag_declaration?).map do |kind|
        if !starts_with_tool
          Variant.new(kind, nil, platform, "example does not start with #{tool.inspect}")
        elsif folder == "windows" && POSIX_ONLY.includes?(kind)
          Variant.new(kind, nil, platform, "POSIX-only variant")
        elsif kind.exe_suffix? || kind.cmd_exe?
          windows_variant(kind, example, tool, folder)
        elsif operators && kind.subject.rule?
          Variant.new(kind, nil, platform, "example contains shell operators")
        else
          text_variant(kind, example, tokens, tool, known_flags, platform)
        end
      end
    end

    private def self.text_variant(kind, example, tokens, tool, known_flags, platform) : Variant
      command, reason = case kind
                        when .reorder?    then reorder(tokens)
                        when .split?      then split(tokens, known_flags)
                        when .combine?    then combine(tokens)
                        when .quote?      then quote(tokens)
                        when .env_prefix? then {"BENCH_VAR=1 #{example}", nil}
                        when .abs_path?   then {"/usr/bin/#{example}", nil}
                        when .compound?   then {"ls && #{example}", nil}
                        when .sudo?       then {"sudo #{example}", nil}
                        when .shell_wrap? then {"sh -c #{Process.quote_posix(example)}", nil}
                        else                   {nil, "not generated by this kind"}
                        end
      Variant.new(kind, command, platform, reason)
    end

    private def self.windows_variant(kind, example, tool, folder) : Variant
      unless folder == "posix"
        return Variant.new(kind, nil, TargetPlatform::WindowsCmd, "ruleset does not apply on Windows")
      end

      if kind.exe_suffix?
        Variant.new(kind, "#{tool}.exe#{example[tool.size..]}", TargetPlatform::WindowsPowershell)
      else
        Variant.new(kind, example, TargetPlatform::WindowsCmd)
      end
    end

    # Reverses the leading block of flags, e.g. `rm -r -f x` becomes `rm -f -r x`.
    private def self.reorder(tokens) : {String?, String?}
      block = leading_flags(tokens)
      return {nil, "fewer than two leading flags"} if block.size < 2

      reordered = [tokens.first] + block.reverse + tokens[(block.size + 1)..]
      {Process.quote_posix(reordered), nil}
    end

    # Splits the first combined short-flag token into single-letter flags,
    # e.g. `rm -rf x` becomes `rm -r -f x`. Only splits when every resulting
    # flag is known to the ruleset, since `-exec` and `-rf` look alike.
    private def self.split(tokens, known_flags) : {String?, String?}
      index = tokens.index { |token| token.matches?(/\A-[A-Za-z]{2,}\z/) && !known_flags.includes?(token) }
      return {nil, "no combined short flags"} unless index

      letters = tokens[index][1..].chars.map { |char| "-#{char}" }
      unless letters.all? { |flag| known_flags.includes?(flag) }
        return {nil, "cannot tell combined flags from a word flag without a flag declaration"}
      end

      {Process.quote_posix(tokens[0...index] + letters + tokens[(index + 1)..]), nil}
    end

    # Combines the first two adjacent single-letter flags, e.g. `rm -r -f x`
    # becomes `rm -rf x`.
    private def self.combine(tokens) : {String?, String?}
      single = /\A-[A-Za-z]\z/
      index = (0...(tokens.size - 1)).find { |i| tokens[i].matches?(single) && tokens[i + 1].matches?(single) }
      return {nil, "no adjacent single-letter flags"} unless index

      combined = "-#{tokens[index][1]}#{tokens[index + 1][1]}"
      {Process.quote_posix(tokens[0...index] + [combined] + tokens[(index + 2)..]), nil}
    end

    # Wraps the first argument in single quotes, e.g. `rm -rf build` becomes
    # `rm -rf 'build'`.
    private def self.quote(tokens) : {String?, String?}
      index = (1...tokens.size).find { |i| !tokens[i].starts_with?('-') && !tokens[i].includes?('\'') }
      return {nil, "no argument to quote"} unless index

      words = tokens.map_with_index do |token, i|
        i == index ? "'#{token}'" : Process.quote_posix(token)
      end
      {words.join(' '), nil}
    end

    private def self.leading_flags(tokens) : Array(String)
      tokens.skip(1).take_while { |token| token.starts_with?('-') && token != "-" && token != "--" }
    end
  end
end
